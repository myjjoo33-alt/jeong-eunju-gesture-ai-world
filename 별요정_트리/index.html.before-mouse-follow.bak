<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>내가 밝히는 크리스마스트리</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#080f12;color:#f6f0df;font-family:"Malgun Gothic",system-ui,sans-serif}main{max-width:1440px;margin:auto;padding:38px 48px 24px}.eyebrow{color:#bca47a;font-size:12px;letter-spacing:.14em}header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}h1{font-size:clamp(25px,3vw,37px);font-weight:500;letter-spacing:-.06em;margin:12px 0}header p{color:#9da9a6;font-size:14px;margin:0}.badge{font-size:12px;color:#bdc8c0;border:1px solid #34423b;border-radius:30px;padding:10px 15px;white-space:nowrap}.badge::before{content:"";display:inline-block;width:6px;height:6px;background:#8a9688;border-radius:50%;margin-right:8px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px}.scene{position:relative;min-height:560px;height:70vh;max-height:760px;overflow:hidden;border:1px solid #29372f;border-radius:20px;background:radial-gradient(ellipse at 50% 90%,#1a2c25 0,#0b1818 40%,#071014 80%)}.scene::after{content:"";position:absolute;bottom:9%;left:25%;width:50%;height:4%;background:#bfb38b;filter:blur(32px);opacity:.07}.tree{width:100%;height:92%;display:block}.scene-note{position:absolute;bottom:22px;left:15px;right:15px;text-align:center;font-size:13px;color:#899b91;letter-spacing:.02em}.camera-panel{padding:26px 22px;border:1px solid #2c3934;background:#101a1b;border-radius:20px;align-self:start}.step{font-size:11px;color:#bca47a;letter-spacing:.08em}h2{font-size:20px;font-weight:500;letter-spacing:-.04em;line-height:1.6;margin:16px 0}.camera-view{position:relative;aspect-ratio:4/3;overflow:hidden;background:#081012;border:1px solid #2e3c36;border-radius:12px;margin:20px 0}.placeholder{position:absolute;inset:0;display:grid;place-content:center;text-align:center;gap:10px;font-size:12px;color:#83998b}.placeholder span{font-size:32px;color:#8b815c}video{display:block;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}[hidden]{display:none!important}.buttons{display:flex;gap:9px}button{border:0;border-radius:10px;font:inherit;font-size:14px;cursor:pointer;padding:13px 16px;flex:1}#start{background:#e2ca8e;color:#1e251d}#stop{background:#24352e;color:#e2e7dd}button:disabled{opacity:.4;cursor:default}button:focus-visible{outline:2px solid #fff;outline-offset:4px}#status{font-size:13px;line-height:1.8;color:#bdc9be;min-height:68px;margin:18px 0 0}.privacy{padding-top:18px;border-top:1px solid #2b3832;color:#859b8e;font-size:11px;line-height:1.8;margin:18px 0 0}footer{color:#72887e;font-size:11px;margin-top:20px;display:flex;justify-content:space-between;gap:16px}@media(max-width:850px){main{padding:24px 20px}.layout{grid-template-columns:1fr}.scene{min-height:380px;height:55vh}.camera-panel{width:100%}.camera-view{max-width:360px}.badge{display:none}footer{flex-direction:column;gap:5px}}
.fairy{position:absolute;z-index:1;left:26%;top:45%;width:160px;aspect-ratio:180/190;transform:translate(-50%,-50%);pointer-events:none;filter:drop-shadow(0 0 17px #efca6655)}.fairy svg{display:block;width:100%;height:100%}.fairy-face{position:absolute;left:50%;top:49.5%;width:30%;height:33%;transform:translate(-50%,-50%);border-radius:50%;border:2px solid #fff1b4;background:#cfa861;object-fit:cover}.face-controls{margin:18px 0 0;padding-top:16px;border-top:1px solid #2b3832}.face-controls label{display:flex;justify-content:space-between;font-size:13px;color:#dccb9d}.face-controls input{width:100%;margin:16px 0 6px;accent-color:#e2ca8e}.face-controls p{font-size:12px;line-height:1.8;color:#9eafa3;margin:4px 0}input:focus-visible{outline:2px solid #fff;outline-offset:3px}@media(max-width:850px){.fairy{width:135px;left:23%}}
</style>
</head>
<body>
<main>
<header><div><div class="eyebrow">A LITTLE LIGHT, A LITTLE MAGIC</div><h1>내가 밝히는 크리스마스트리</h1><p>당신의 작은 빛이, 크리스마스가 되는 순간.</p></div><div class="badge" id="badge">카메라 꺼짐</div></header>
<div class="layout">
<section class="scene" aria-label="불이 켜지기를 기다리는 커다란 크리스마스트리">
<svg class="tree" viewBox="0 0 600 650" role="img" aria-label="어두운 밤의 크리스마스트리">
<defs><linearGradient id="pine" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#254238"/><stop offset="1" stop-color="#11281f"/></linearGradient></defs>
<g fill="#779388" opacity=".25"><circle cx="93" cy="92" r="1.3"/><circle cx="480" cy="135" r="1"/><circle cx="153" cy="225" r="1"/><circle cx="445" cy="313" r="1.2"/><circle cx="70" cy="403" r="1"/><circle cx="520" cy="447" r="1.4"/><circle cx="410" cy="66" r="1"/></g>
<ellipse cx="300" cy="590" rx="180" ry="15" fill="#07120e"/>
<path d="M285 530h30v62h-30z" fill="#3c3528"/>
<g fill="url(#pine)" stroke="#345040" stroke-width="1.5" stroke-linejoin="round">
<path d="M300 105 Q274 164 235 205 Q268 213 300 208 Q334 214 365 205 Q325 165 300 105Z"/>
<path d="M300 155 Q252 246 185 302 Q243 318 300 303 Q360 318 415 302 Q347 243 300 155Z"/>
<path d="M300 239 Q230 358 133 418 Q220 442 300 421 Q383 442 467 418 Q369 350 300 239Z"/>
<path d="M300 335 Q204 487 79 550 Q193 580 300 555 Q412 580 521 550 Q393 479 300 335Z"/>
</g>
<g fill="none" stroke="#677053" stroke-width="2" opacity=".28"><path d="M253 192q47 40 93 6"/><path d="M213 282q88 61 174 0"/><path d="M170 398q132 69 261 0"/><path d="M121 531q179 71 357 0"/></g>
<g fill="#5c5240" stroke="#87734f" stroke-width="1" opacity=".5"><circle cx="283" cy="215" r="7"/><circle cx="336" cy="253" r="8"/><circle cx="245" cy="302" r="8"/><circle cx="362" cy="330" r="8"/><circle cx="211" cy="387" r="9"/><circle cx="301" cy="379" r="8"/><circle cx="395" cy="414" r="9"/><circle cx="263" cy="457" r="9"/><circle cx="171" cy="509" r="9"/><circle cx="335" cy="508" r="9"/><circle cx="434" cy="536" r="8"/></g>
<path d="m300 69 9 19 21 3-15 15 4 21-19-10-19 10 4-21-15-15 21-3Z" fill="#746444" stroke="#a18a58" opacity=".6"/>
</svg>
<div class="fairy" id="fairy" hidden role="img" aria-label="내 얼굴이 들어간 작은 별 요정">
<svg viewBox="0 0 180 190" aria-hidden="true">
<defs><linearGradient id="fairyGold" x1="0" y1="0" x2="0.7" y2="1"><stop stop-color="#fff7ce"/><stop offset=".5" stop-color="#ebcb78"/><stop offset="1" stop-color="#bb8837"/></linearGradient></defs>
<g fill="#d5f1e8" fill-opacity=".42" stroke="#edfff7" stroke-opacity=".55"><ellipse cx="35" cy="95" rx="18" ry="40" transform="rotate(-37 35 95)"/><ellipse cx="145" cy="95" rx="18" ry="40" transform="rotate(37 145 95)"/></g>
<path d="M90 21 110 72 166 76 123 112 136 166 90 137 44 166 57 112 14 76 70 72Z" fill="url(#fairyGold)" stroke="#ffedb1" stroke-width="2" stroke-linejoin="round"/>
<g fill="#fff1be"><path d="m24 33 2 7 7 2-7 2-2 7-2-7-7-2 7-2Z"/><path d="m158 133 2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/><circle cx="60" cy="175" r="2"/><circle cx="148" cy="38" r="2"/></g>
</svg>
<canvas class="fairy-face" id="fairyFace" width="160" height="192" aria-hidden="true"></canvas>
</div>
<div class="scene-note" id="sceneNote">아직 잠들어 있는 트리, 곧 당신의 빛을 만나요.</div>
</section>
<aside class="camera-panel"><div class="step">두 번째 실습 · 나의 별 요정</div><h2>나의 별 요정을<br>만나볼까요?</h2>
<div class="camera-view"><div class="placeholder" id="placeholder"><span aria-hidden="true">✧</span>이곳에 내 모습이 나타나요</div><video id="camera" autoplay muted playsinline hidden aria-label="내 웹캠 영상"></video></div>
<div class="buttons"><button id="start" type="button">웹캠 켜기</button><button id="stop" type="button" disabled>끄기</button></div>
<div class="face-controls" id="faceControls" hidden>
<label for="faceZoom">얼굴 확대 <output id="zoomValue" for="faceZoom">1.6배</output></label>
<input id="faceZoom" type="range" min="1" max="3" step="0.1" value="1.6">
<p>얼굴을 카메라 화면 가운데에 맞춰 주세요.<br>별 안에 얼굴이 잘 보이도록 확대를 조절해요.</p>
</div>
<p id="status" role="status" aria-live="polite">웹캠을 켜면 트리 옆에 내 얼굴이 들어간 별 요정이 나타나요.</p>
<p class="privacy">카메라 영상은 이 PC 안에서만 사용해요.<br>녹화하거나 전송하지 않으며, 마이크는 켜지지 않아요.</p>
</aside>
</div>
<footer><span>별 요정 안에 내 얼굴이 보이면 이번 실습 성공이에요.</span><span>마우스를 따라가는 움직임은 다음 단계에서 함께 만들어요.</span></footer>
</main>
<script>
'use strict';
const video=document.getElementById('camera'),start=document.getElementById('start'),stop=document.getElementById('stop'),status=document.getElementById('status'),placeholder=document.getElementById('placeholder'),badge=document.getElementById('badge');
const fairy=document.getElementById('fairy'),face=document.getElementById('fairyFace'),faceContext=face.getContext('2d'),faceControls=document.getElementById('faceControls'),faceZoom=document.getElementById('faceZoom'),zoomValue=document.getElementById('zoomValue'),sceneNote=document.getElementById('sceneNote');
let stream=null,requestId=0,faceFrame=0;
faceZoom.addEventListener('input',()=>{zoomValue.value=Number(faceZoom.value).toFixed(1)+'배';});
function paintFace(){
 if(!stream)return;
 if(video.readyState>=2&&video.videoWidth&&video.videoHeight){
  const cropHeight=Math.min(video.videoHeight,video.videoWidth*face.height/face.width)/Number(faceZoom.value),cropWidth=cropHeight*face.width/face.height;
  faceContext.save();faceContext.translate(face.width,0);faceContext.scale(-1,1);
  faceContext.drawImage(video,(video.videoWidth-cropWidth)/2,(video.videoHeight-cropHeight)/2,cropWidth,cropHeight,0,0,face.width,face.height);faceContext.restore();
 }
 faceFrame=requestAnimationFrame(paintFace);
}
function turnOff(message='웹캠을 껐어요. 다시 켜서 확인할 수 있어요.'){
 requestId++;
 cancelAnimationFrame(faceFrame);faceFrame=0;faceContext.clearRect(0,0,face.width,face.height);
 fairy.hidden=true;faceControls.hidden=true;sceneNote.textContent='아직 잠들어 있는 트리, 곧 당신의 빛을 만나요.';
 if(stream)stream.getTracks().forEach(track=>track.stop());
 stream=null;video.srcObject=null;video.hidden=true;placeholder.hidden=false;
 start.disabled=false;stop.disabled=true;badge.textContent='카메라 꺼짐';status.textContent=message;
}
start.addEventListener('click',async()=>{
 const id=++requestId;let incoming=null;
 start.disabled=true;stop.disabled=false;status.textContent='카메라 사용을 허용해 주세요. 기다리는 동안 끄기를 눌러 취소할 수 있어요.';
 try{
  if(!navigator.mediaDevices?.getUserMedia)throw new Error('LOCAL_ADDRESS');
  incoming=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:1280},height:{ideal:720}},audio:false});
  if(id!==requestId){incoming.getTracks().forEach(track=>track.stop());return;}
  stream=incoming;video.srcObject=stream;await video.play();
  if(id!==requestId)return;
  video.hidden=false;placeholder.hidden=true;badge.textContent='카메라 켜짐';paintFace();fairy.hidden=false;faceControls.hidden=false;sceneNote.textContent='당신의 별 요정이 찾아왔어요.';status.textContent='트리 옆의 별 요정을 보세요. 얼굴을 카메라 가운데에 맞추고, 얼굴 확대를 조절해 주세요.';
  stream.getVideoTracks()[0].addEventListener('ended',()=>{if(id===requestId)turnOff('카메라 연결이 끊어졌어요. 연결을 확인하고 다시 켜주세요.');});
 }catch(error){
  if(incoming)incoming.getTracks().forEach(track=>track.stop());
  if(id!==requestId)return;
  const messages={NotAllowedError:'카메라 사용이 허용되지 않았어요. Chrome 주소창 왼쪽의 사이트 설정에서 카메라를 허용하고 다시 켜주세요.',NotFoundError:'연결된 카메라를 찾지 못했어요. 카메라 연결을 확인하고 다시 켜주세요.',NotReadableError:'카메라를 열지 못했어요. 카메라를 쓰는 다른 앱을 닫고 다시 켜주세요.'};
  turnOff(error.message==='LOCAL_ADDRESS'?'이 폴더의 실행.cmd로 열어주세요.':messages[error.name]||'카메라를 켜지 못했어요. 카메라 연결과 Chrome 권한을 확인하고 다시 시도해 주세요.');
 }
});
stop.addEventListener('click',()=>turnOff());
window.addEventListener('pagehide',()=>turnOff());
</script>
</body>
</html>
